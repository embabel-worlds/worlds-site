---
/*
 * The one command, and a copy button. It is the page's whole call to action, so
 * it is a component: every place it appears must show the same string, and the
 * string must be the one the site actually serves.
 */
interface Props {
  id?: string
}
const { id } = Astro.props
import { INSTALL_COMMAND } from '../site'
---

<div class="cmd" id={id}>
  <code data-install-command>{INSTALL_COMMAND}</code>
  <button type="button" data-copy>Copy</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', () => {
      const code = button.parentElement?.querySelector('[data-install-command]')?.textContent?.trim()
      if (!code) return
      navigator.clipboard.writeText(code).then(() => {
        button.textContent = 'Copied'
        setTimeout(() => { button.textContent = 'Copy' }, 1600)
      })
    })
  }
</script>
